# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
# Chave service_role: fica SÓ no servidor (Vercel env). Nunca usar prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Código do link de acesso. Quem tiver o link /?k=<ACCESS_KEY> preenche e edita.
# Gere algo longo e aleatório, ex: openssl rand -hex 16
ACCESS_KEY=
