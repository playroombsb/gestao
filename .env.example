# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
# Chave service_role: fica SÓ no servidor (.env.local da VPS). Nunca usar prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Assina o cookie de sessão do login. 32 caracteres ou mais (ex: openssl rand -hex 32).
# Trocar este valor desloga todo mundo.
SESSION_SECRET=

# Token que o formulário do site manda em Authorization: Bearer <token> para /api/aplicacoes (openssl rand -hex 24).
APLICACOES_TOKEN=

# Coletor do Instagram (scraper/). Perfil padrão: playroombsb. Proxy residencial é preciso para rodar da VPS.
INSTAGRAM_PERFIL=
INSTAGRAM_PROXY=

# Link secreto da agenda em .ics para assinar no Google Agenda (/api/agenda?t=<token>). Trocar invalida o link antigo.
AGENDA_ICS_TOKEN=

# WhatsApp do Playroom pela Evolution API (roda na VPS do Playroom). Só o servidor usa.
# EVOLUTION_URL: endereço HTTPS da Evolution. EVOLUTION_API_KEY: chave global (AUTHENTICATION_API_KEY da Evolution).
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=playroom
# Token do webhook que a Evolution chama em /api/whatsapp/webhook?t=<token> (openssl rand -hex 24). Trocar exige reconectar em Integrações.
WHATSAPP_WEBHOOK_TOKEN=
