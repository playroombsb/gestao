# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
# Chave service_role: fica SÓ no servidor (.env.local da VPS). Nunca usar prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional. Vazio = acesso aberto: o endereço puro abre e qualquer pessoa edita.
# Preenchido = só quem tiver o link /?k=<ACCESS_KEY> preenche e edita (ex: openssl rand -hex 16).
ACCESS_KEY=

# Opcional: código só de leitura para o painel (/painel?k=<PAINEL_KEY>). Sem ele, o painel abre com a ACCESS_KEY.
PAINEL_KEY=
