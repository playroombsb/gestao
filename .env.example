# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
# Chave service_role: fica SÓ no servidor (.env.local da VPS). Nunca usar prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Assina o cookie de sessão do login. 32 caracteres ou mais (ex: openssl rand -hex 32).
# Trocar este valor desloga todo mundo.
SESSION_SECRET=
